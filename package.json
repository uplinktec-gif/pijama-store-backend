{
  "name": "pijama-store-backend",
  "version": "1.0.0",
  "description": "Sistema de gestão de vendas e estoque para loja de pijamas",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --detectOpenHandles",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --detectOpenHandles",
    "seed": "node scripts/seed-estoque.js"
  },
  "keywords": [
    "pijamas",
    "vendas",
    "estoque",
    "whatsapp",
    "sheets"
  ],
  "author": "Felipe & Júlly",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.7.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-session": "^1.19.0",
    "google-auth-library": "^9.4.1",
    "googleapis": "^118.0.0",
    "groq-sdk": "^1.2.0",
    "joi": "^17.13.1",
    "jsonwebtoken": "^9.0.3",
    "node-schedule": "^2.1.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "uuid": "^9.0.1",
    "winston": "^3.14.2",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^6.3.3"
  }
}
