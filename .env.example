# Google Sheets
GOOGLE_SHEETS_CREDENTIALS_PATH=./service-account.json
GOOGLE_SHEETS_ID=seu_sheet_id_aqui

# WhatsApp Business API
WHATSAPP_PHONE_NUMBER_ID=seu_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=seu_business_account_id
WHATSAPP_ACCESS_TOKEN=seu_access_token
WHATSAPP_VERIFY_TOKEN=seu_verify_token_arbitrario

# Claude API
ANTHROPIC_API_KEY=sk-ant-sua_key_aqui

# App Config
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Números WhatsApp Autorizados (Felipe e Júlly)
# Formato: +5595988123456,+5595987654321
AUTHORIZED_WHATSAPP_NUMBERS=5595988123456,5595987654321

# Catálogo de Modelos (JSON stringificado)
CATALOG_MODELS=ZARA,MIA,LIA,NÚBIA,LÍVIA,BEATRIZ,ANNE
CATALOG_SIZES=P,M,G,GG
CATALOG_COLORS=azul marinho,preto,bordô,cinza,marrom

# Preços por modelo (JSON)
MODEL_PRICES={"ZARA":129.90,"MIA":89.90,"LIA":129.90,"NÚBIA":169.90,"LÍVIA":129.90,"BEATRIZ":89.90,"ANNE":159.90}

# Google OAuth 2.0 (autenticação na loja online)
# Obter em: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=seu_client_id_aqui.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_client_secret_aqui
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Session Secret (para autenticação de clientes no portal)
CLIENTE_SESSION_SECRET=seu_session_secret_aleatorio_aqui
