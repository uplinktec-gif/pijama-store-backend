# ================================================================
# PIJAMA STORE BACKEND — Variáveis de Ambiente
# ================================================================
# Copie este arquivo para .env e preencha os valores

# ─── WhatsApp (Evolution API) ────────────────────────────────────
WHATSAPP_VERIFY_TOKEN=seu_verify_token_arbitrario
EVOLUTION_API_KEY=sua_evolution_api_key
EVOLUTION_API_URL=http://177.7.47.211:32775
EVOLUTION_INSTANCE=pijama-store

# ─── Claude / Anthropic ──────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-sua_key_aqui

# ─── App Config ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
LOG_LEVEL=info

# ─── Banco de Dados SQLite ────────────────────────────────────────
DB_PATH=./data/pijama-store.db

# ─── Painel Admin ────────────────────────────────────────────────
# IPs permitidos para acessar /admin (separados por vírgula)
ADMIN_ALLOWED_IPS=127.0.0.1,::1,::ffff:127.0.0.1
# Token opcional (segunda camada, header x-admin-token)
# ADMIN_TOKEN=minha-senha-admin

# ─── Números WhatsApp ────────────────────────────────────────────
AUTHORIZED_WHATSAPP_NUMBERS=5595988123456,5595987654321,5595991268494
NUMERO_FELIPE=95981188675
NUMERO_JULLY=95981225668
NUMERO_PLUMA=95991268494

# ─── Catálogo de Produtos ────────────────────────────────────────
CATALOG_MODELS=ZARA,MIA,LIA,NÚBIA,LÍVIA,BEATRIZ,ANNE
CATALOG_SIZES=P,M,G,GG
CATALOG_COLORS=azul marinho,preto,bordô,cinza,marrom

# Preços por modelo (JSON)
MODEL_PRICES={"ZARA":129.90,"MIA":89.90,"LIA":129.90,"NÚBIA":169.90,"LÍVIA":129.90,"BEATRIZ":89.90,"ANNE":159.90}

# ─── Google OAuth 2.0 (Portal do Cliente — opcional) ─────────────
# Obter em: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Session Secret (para autenticação de clientes no portal)
CLIENTE_SESSION_SECRET=seu_session_secret_aleatorio_aqui

# ─── Google Sheets (LEGADO — apenas para referência) ─────────────
# Não é mais necessário desde a migração para SQLite
# GOOGLE_SHEETS_CREDENTIALS_PATH=./service-account.json
# GOOGLE_SHEETS_ID=seu_sheet_id_aqui
